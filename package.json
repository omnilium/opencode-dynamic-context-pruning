{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@omnilium/opencode-dcp",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@12.4.2",
    "description": "OpenCode plugin that optimizes token usage by pruning obsolete tool outputs from conversation context",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./tui.tsx"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && tsup && tsc --emitDeclarationOnly",
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "pnpm run build && pnpm run verify:package",
        "prepublishOnly": "pnpm run check:package",
        "dev": "opencode plugin dev",
        "sandbox": "node scripts/sandbox.mjs",
        "typecheck": "tsc --noEmit && pnpm --filter opencode-request-logger run typecheck",
        "test": "node --import tsx --test tests/*.test.ts && pnpm --filter opencode-request-logger run test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dcp": "tsx scripts/print.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/omnilium/opencode-dynamic-context-pruning.git"
    },
    "bugs": {
        "url": "https://github.com/omnilium/opencode-dynamic-context-pruning/issues"
    },
    "homepage": "https://github.com/omnilium/opencode-dynamic-context-pruning#readme",
    "author": "Omnilium",
    "contributors": [
        "tarquinen"
    ],
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.29"
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opencode-ai/sdk": "^1.4.3",
        "@opencode/ai": "^2.0.12",
        "@opentui/core": "^0.4.5",
        "@opentui/solid": "^0.4.5",
        "jsonc-parser": "^3.3.1",
        "solid-js": "^1.9.12",
        "zod": "4.1.8"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.18.29",
        "@opencode/plugin": "^2.0.4",
        "@opencode/theme": "^2.0.4",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "files": [
        "dist/",
        "lib/",
        "server.js",
        "tui.tsx",
        "README.md",
        "LICENSE"
    ]
}
